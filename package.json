{
    "name": "saveme-games",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node tools/dev.mjs",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview --host 127.0.0.1",
        "typecheck": "tsc --noEmit",
        "test:e2e": "playwright test",
        "dev:web": "vite --host 127.0.0.1",
        "dev:api": "npm run dev --prefix backend",
        "setup": "npm ci --include=dev && npm ci --include=dev --prefix backend && npm run prisma:generate --prefix backend",
        "build:production": "npm run build -- --mode cloud && npm run build --prefix backend && node tools/package-web.mjs",
        "start:production": "node tools/start-production.mjs",
        "db:migrate": "npm run db:migrate --prefix backend",
        "test:production": "node --test tools/production.test.mjs"
    },
    "dependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^22.20.5",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@vitejs/plugin-react": "^4.3.4",
        "tailwindcss": "^4.3.3",
        "typescript": "~5.7.3",
        "vite": "^6.4.6"
    }
}
