{
  "manifest_version": 3,
  "name": "SaveMe Games",
  "version": "0.1.0",
  "description": "Mostra os preços da Steam e da Epic nos resultados do Google.",
  "host_permissions": ["http://127.0.0.1:5173/*"],
  "background": { "service_worker": "prices.js" },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/search*", "https://www.google.com.br/search*"],
      "js": ["google-search.js"],
      "css": ["google-search.css"]
    }
  ]
}
